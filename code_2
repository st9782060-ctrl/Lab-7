#include <iostream>

using namespace std;

int main() {
    double pi4 = 0.0;
    long n;

    cout << "Number of iterations? (e.g. 10, 1000, 100000): ";
    cin >> n;

    if (n <= 0) {
        cout << "Error: Number of iterations must be positive." << endl;
        return 1;
    }

    for (long i = 0; i < n; i++) {
        double term = 1.0 / (2.0 * i + 1.0);
        if (i % 2 == 0) {
            pi4 += term;
        } else {
            pi4 -= term;
        }
    }

    cout.precision(20);
    cout << "Pi = " << (pi4 * 4.0) << endl;

    cout << "Press Enter to exit...";
    cin.ignore();
    cin.get();
    return 0;
}
